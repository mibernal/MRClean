---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { url } from '../lib/url';
import { waLink } from '../lib/contact';
import { SITE } from '../config/site';

const nav = [
  { href: '/catalogo/?linea=profesional', label: 'Línea profesional' },
  { href: '/catalogo/?linea=hogar', label: 'Hogar' },
  { href: '/#como-cotizar', label: 'Cómo cotizar' },
  { href: '/#contacto', label: 'Contacto' },
];
---
<header class="sticky top-0 z-40 border-b border-line/80 bg-white/85 backdrop-blur-lg supports-[backdrop-filter]:bg-white/70">
  <div class="container-x flex h-16 items-center justify-between gap-4 lg:h-[72px]">
    <a href={url('/')} aria-label={`${SITE.name} — inicio`}><Logo /></a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Principal">
      {nav.map((n) => (
        <a href={url(n.href)} data-nav={n.href} class="rounded-full px-4 py-2 text-sm font-medium text-ink-2 transition hover:bg-paper hover:text-ink aria-[current=page]:bg-paper aria-[current=page]:font-semibold aria-[current=page]:text-ink">{n.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={url('/catalogo/')} class="hidden size-10 place-items-center rounded-full text-ink-2 transition hover:bg-paper sm:grid" aria-label="Buscar en el catálogo">
        <Icon name="search" />
      </a>
      <a href={url('/cotizacion/')} class="relative grid size-10 place-items-center rounded-full text-ink-2 transition hover:bg-paper" aria-label="Ver mi cotización">
        <Icon name="clipboard" />
        <span data-quote-count hidden class="absolute -right-0.5 -top-0.5 grid min-w-5 place-items-center rounded-full bg-accent px-1 text-[11px] font-bold leading-5 text-ink">0</span>
      </a>
      <a href={waLink(`Hola ${SITE.name}, quisiera información sobre sus equipos.`)} target="_blank" rel="noopener noreferrer" class="btn-wa hidden !py-2.5 md:inline-flex">
        <Icon name="whatsapp" size={18} /> Cotizar
      </a>
      <button type="button" id="menu-btn" class="grid size-10 place-items-center rounded-full text-ink transition hover:bg-paper lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú">
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-white lg:hidden">
    <nav class="container-x flex flex-col py-3" aria-label="Móvil">
      <a href={url('/catalogo/')} class="rounded-xl px-3 py-3 font-medium hover:bg-paper">Todo el catálogo</a>
      {nav.map((n) => <a href={url(n.href)} class="rounded-xl px-3 py-3 font-medium hover:bg-paper">{n.label}</a>)}
      <a href={url('/cotizacion/')} class="rounded-xl px-3 py-3 font-medium hover:bg-paper">Mi cotización</a>
    </nav>
  </div>
</header>

<script>
  // Marca la sección activa (la línea viene en la URL, por eso se resuelve en el navegador)
  const here = new URLSearchParams(location.search).get('linea');
  const onCatalog = /\/catalogo\/?$/.test(location.pathname);
  document.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach((a) => {
    const line = new URL(a.href).searchParams.get('linea');
    if (onCatalog && line && line === here) a.setAttribute('aria-current', 'page');
  });
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('hidden', open);
  });
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) { menu.classList.add('hidden'); btn?.setAttribute('aria-expanded', 'false'); }
  });
</script>
