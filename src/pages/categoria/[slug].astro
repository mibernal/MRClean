---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCategories, getProducts, type Category } from '../../lib/db';
import { url, img } from '../../lib/url';
import { waLink } from '../../lib/contact';
import { SITE } from '../../config/site';

export function getStaticPaths() {
  return getCategories().map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
interface Props { c: Category }
const { c } = Astro.props;
const products = getProducts().filter((p) => p.category.slug === c.slug);
const siblings = getCategories(c.line);
const lineLabel = c.line === 'hogar' ? 'Línea hogar' : 'Línea profesional';
const abs = (path: string) => new URL(url(path), Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: abs('/') },
        { '@type': 'ListItem', position: 2, name: 'Catálogo', item: abs('/catalogo/') },
        { '@type': 'ListItem', position: 3, name: c.name, item: abs(`/categoria/${c.slug}/`) },
      ],
    },
    {
      '@type': 'ItemList',
      name: c.name,
      numberOfItems: products.length,
      itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/producto/${p.slug}/`), name: p.name })),
    },
  ],
};
const hero = products.find((p) => p.photos.length)?.photos[0];
---
<Base title={c.name} description={`${c.name}: ${c.description ?? ''} ${products.length} productos con ficha técnica. Cotice por WhatsApp o correo con ${SITE.name}.`} jsonld={jsonld}>
  <section class="border-b border-line bg-paper">
    <div class="container-x grid items-center gap-8 py-10 sm:py-14 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <nav class="flex flex-wrap items-center gap-1.5 text-sm text-mute" aria-label="Ruta">
          <a href={url('/')} class="hover:text-ink">Inicio</a><span aria-hidden="true">/</span>
          <a href={url('/catalogo/')} class="hover:text-ink">Catálogo</a><span aria-hidden="true">/</span>
          <span class="text-ink" aria-current="page">{c.name}</span>
        </nav>
        <p class="eyebrow mt-6">{lineLabel}</p>
        <h1 class="mt-2 text-3xl font-extrabold sm:text-5xl">{c.name}</h1>
        {c.description && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-mute">{c.description}</p>}
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <span class="rounded-full bg-white px-3.5 py-1.5 text-sm font-semibold ring-1 ring-line">{products.length} {products.length === 1 ? 'producto' : 'productos'}</span>
          <a href={waLink(`Hola ${SITE.name}, necesito asesoría con ${c.name.toLowerCase()}.`)} target="_blank" rel="noopener noreferrer" class="btn-wa !py-2.5"><Icon name="whatsapp" size={18} /> Asesoría para elegir</a>
        </div>
      </div>
      {hero && (
        <div class="relative hidden aspect-[4/3] lg:block">
          <img src={img(hero.src)} alt="" class="absolute inset-0 m-auto h-full w-full object-contain mix-blend-multiply" fetchpriority="high" />
        </div>
      )}
    </div>
  </section>

  <nav class="sticky top-16 z-30 border-b border-line bg-white/90 backdrop-blur-lg lg:top-[72px]" aria-label="Categorías">
    <div class="container-x flex gap-2 overflow-x-auto py-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {siblings.map((s) => (
        <a href={url(`/categoria/${s.slug}/`)} class="chip" aria-current={s.slug === c.slug ? 'page' : undefined}
>{s.name}<span class="text-xs opacity-80">{s.count}</span></a>
      ))}
    </div>
  </nav>

  <section class="container-x py-8">
    <h2 class="sr-only">Productos de {c.name}</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {products.map((p, i) => <ProductCard p={p} eager={i < 4} />)}
    </div>
    <div class="mt-12 flex flex-col items-center gap-4 rounded-3xl bg-ink px-6 py-10 text-center text-white sm:px-12">
      <h2 class="text-2xl font-extrabold">¿No está seguro de cuál elegir?</h2>
      <p class="max-w-xl text-slate-300">Cuéntenos qué superficie limpia, con qué frecuencia y qué voltaje tiene disponible. Le recomendamos el equipo adecuado.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={waLink(`Hola ${SITE.name}, necesito asesoría con ${c.name.toLowerCase()}.`)} target="_blank" rel="noopener noreferrer" class="btn-wa"><Icon name="whatsapp" size={18} /> Hablar con un asesor</a>
        <a href={url('/catalogo/')} class="btn border border-white/20 text-white hover:bg-white/10">Ver todo el catálogo</a>
      </div>
    </div>
  </section>
</Base>
