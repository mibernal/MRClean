---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url';

const input = 'w-full rounded-xl border border-line px-4 py-3 text-[15px] outline-none transition focus:border-ink focus:ring-4 focus:ring-brand/40';
---
<Base title="Mi cotización" description="Revise los productos seleccionados y envíe su solicitud de cotización por WhatsApp o correo." floatingWa={false}>
  <section class="border-b border-line bg-paper">
    <div class="container-x py-10 sm:py-14">
      <p class="eyebrow">Mi cotización</p>
      <h1 class="mt-2 text-3xl font-extrabold sm:text-5xl">Solicitud de cotización</h1>
      <p class="mt-3 max-w-2xl text-mute">Ajuste cantidades, complete sus datos y envíe la lista. Le respondemos con precio, disponibilidad y tiempos de entrega.</p>
    </div>
  </section>

  <section class="container-x grid gap-8 py-10 lg:grid-cols-[1.4fr_1fr]">
    <div>
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold">Productos <span id="n" class="text-mute"></span></h2>
        <button type="button" id="clear" class="hidden items-center gap-1.5 text-sm font-medium text-mute hover:text-red-600"><Icon name="trash" size={16} /> Vaciar lista</button>
      </div>
      <ul id="items" class="mt-4 divide-y divide-line overflow-hidden rounded-3xl border border-line bg-white"></ul>
      <div id="empty" class="mt-4 hidden rounded-3xl border border-dashed border-line px-6 py-16 text-center">
        <span class="mx-auto grid size-14 place-items-center rounded-2xl bg-brand-soft text-ink"><Icon name="clipboard" size={26} /></span>
        <p class="mt-4 text-lg font-semibold">Su lista está vacía</p>
        <p class="mt-1 text-sm text-mute">Recorra el catálogo y toque “Cotizar” en los productos que le interesan.</p>
        <a href={url('/catalogo/')} class="btn-primary mt-6">Ir al catálogo <Icon name="arrow" size={18} /></a>
      </div>
      <template id="row">
        <li class="flex items-center gap-4 p-4 sm:p-5">
          <a data-link class="grid size-20 shrink-0 place-items-center overflow-hidden rounded-2xl border border-line bg-white">
            <img data-img alt="" class="h-[85%] w-[85%] object-contain" />
            <span data-noimg class="text-ink/35"><Icon name="box" size={26} /></span>
          </a>
          <div class="min-w-0 flex-1">
            <a data-link class="block truncate font-semibold hover:text-ink" data-name></a>
            <p class="text-xs text-mute">Ref. <span data-ref class="tabular-nums"></span></p>
          </div>
          <div class="flex items-center rounded-full border border-line">
            <button type="button" data-dec class="grid size-9 place-items-center rounded-full hover:bg-paper" aria-label="Quitar una unidad"><Icon name="minus" size={16} /></button>
            <input data-qty type="number" min="1" max="999" inputmode="numeric" class="w-10 bg-transparent text-center text-sm font-semibold tabular-nums outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none" aria-label="Cantidad" />
            <button type="button" data-inc class="grid size-9 place-items-center rounded-full hover:bg-paper" aria-label="Agregar una unidad"><Icon name="plus" size={16} /></button>
          </div>
          <button type="button" data-del class="grid size-9 place-items-center rounded-full text-mute hover:bg-red-50 hover:text-red-600" aria-label="Eliminar"><Icon name="x" size={18} /></button>
        </li>
      </template>
    </div>

    <form id="quote-form" class="h-fit space-y-4 rounded-3xl border border-line bg-white p-6 sm:p-8 lg:sticky lg:top-28">
      <h2 class="text-lg font-bold">Sus datos</h2>
      <label class="grid gap-1.5 text-sm font-medium">Nombre<input name="nombre" required autocomplete="name" class={input} /></label>
      <label class="grid gap-1.5 text-sm font-medium"><span>Empresa / NIT <span class="text-xs font-normal text-mute">(opcional)</span></span><input name="empresa" autocomplete="organization" class={input} /></label>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="grid gap-1.5 text-sm font-medium">Ciudad<input name="ciudad" required autocomplete="address-level2" class={input} /></label>
        <label class="grid gap-1.5 text-sm font-medium">Teléfono<input name="telefono" type="tel" autocomplete="tel" class={input} /></label>
      </div>
      <label class="grid gap-1.5 text-sm font-medium">Comentarios<textarea name="comentarios" rows="3" placeholder="Uso previsto, voltaje disponible, fecha requerida…" class={input}></textarea></label>
      <p id="err" class="hidden text-sm font-medium text-red-600">Agregue al menos un producto a la lista.</p>
      <div class="grid gap-2.5 pt-1">
        <button type="submit" value="wa" class="btn-wa w-full"><Icon name="whatsapp" size={18} /> Enviar por WhatsApp</button>
        <button type="submit" value="mail" class="btn-ghost w-full"><Icon name="mail" size={18} /> Enviar por correo</button>
      </div>
      <p class="text-xs leading-relaxed text-mute">Sus datos solo se usan para responder esta solicitud. La lista se guarda en este navegador.</p>
    </form>
  </section>
</Base>

<script>
  import { readQuote, setQty, removeFromQuote, clearQuote, onQuoteChange } from '../scripts/quote';
  import { SITE } from '../config/site';

  const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
  const list = document.getElementById('items')!;
  const tpl = document.getElementById('row') as HTMLTemplateElement;
  const empty = document.getElementById('empty')!;
  const clear = document.getElementById('clear')!;
  const n = document.getElementById('n')!;
  const err = document.getElementById('err')!;

  function render() {
    const items = readQuote();
    list.replaceChildren();
    for (const it of items) {
      const li = (tpl.content.cloneNode(true) as DocumentFragment).firstElementChild as HTMLLIElement;
      li.querySelectorAll<HTMLAnchorElement>('[data-link]').forEach((a) => (a.href = `${BASE}/producto/${it.slug}/`));
      li.querySelector('[data-name]')!.textContent = it.name;
      li.querySelector('[data-ref]')!.textContent = it.ref;
      const im = li.querySelector<HTMLImageElement>('[data-img]')!;
      if (it.image) { im.src = `${BASE}/img/productos/${it.image}`; li.querySelector('[data-noimg]')!.remove(); } else im.remove();
      const qty = li.querySelector<HTMLInputElement>('[data-qty]')!;
      qty.value = String(it.qty);
      qty.addEventListener('change', () => setQty(it.slug, Number(qty.value) || 1));
      li.querySelector('[data-dec]')!.addEventListener('click', () => setQty(it.slug, it.qty - 1));
      li.querySelector('[data-inc]')!.addEventListener('click', () => setQty(it.slug, it.qty + 1));
      li.querySelector('[data-del]')!.addEventListener('click', () => removeFromQuote(it.slug));
      list.append(li);
    }
    const has = items.length > 0;
    list.hidden = !has;
    empty.classList.toggle('hidden', has);
    clear.classList.toggle('hidden', !has);
    clear.classList.toggle('inline-flex', has);
    n.textContent = has ? `(${items.reduce((a, i) => a + i.qty, 0)})` : '';
    if (has) err.classList.add('hidden');
  }

  clear.addEventListener('click', () => { if (confirm('¿Vaciar la lista de cotización?')) clearQuote(); });
  onQuoteChange(render);
  render();

  const form = document.getElementById('quote-form') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const items = readQuote();
    if (!items.length) { err.classList.remove('hidden'); return; }
    const d = new FormData(form);
    const g = (k: string) => String(d.get(k) ?? '').trim();
    const lines = [
      `Hola ${SITE.name}, quisiera cotizar los siguientes productos:`,
      '',
      ...items.map((it, i) => `${i + 1}. ${it.name} — Ref. ${it.ref} — Cant. ${it.qty}`),
      '',
      `Nombre: ${g('nombre')}`,
      !!g('empresa') && `Empresa / NIT: ${g('empresa')}`,
      `Ciudad: ${g('ciudad')}`,
      !!g('telefono') && `Teléfono: ${g('telefono')}`,
      !!g('comentarios') && `Comentarios: ${g('comentarios')}`,
    ].filter((l): l is string => typeof l === 'string');
    const text = lines.join('\n');
    const via = (e.submitter as HTMLButtonElement | null)?.value;
    if (via === 'mail') {
      location.href = `mailto:${SITE.email}?subject=${encodeURIComponent(`Solicitud de cotización – ${g('nombre')}`)}&body=${encodeURIComponent(text)}`;
    } else {
      window.open(`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(text)}`, '_blank', 'noopener,noreferrer');
    }
  });
</script>
