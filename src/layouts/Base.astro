---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config/site';
import { img, url } from '../lib/url';
import { waLink } from '../lib/contact';

interface Props {
  title?: string;
  description?: string;
  image?: string | undefined;
  jsonld?: Record<string, unknown>;
  /** Botón flotante de WhatsApp (se oculta donde la página ya tiene sus propios botones) */
  floatingWa?: boolean;
}
const { title, description = SITE.description, image = img('site/og.jpg'), jsonld, floatingWa = true } = Astro.props;
// JSON-LD sin posibilidad de cerrar la etiqueta <script> desde los datos
const ldJson = jsonld ? JSON.stringify(jsonld).replace(/</g, '\\u003c') : null;
// Política de seguridad de contenido (solo en producción; el modo dev usa scripts en línea)
const CSP = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
  'upgrade-insecure-requests',
].join('; ');
const fullTitle = title ? `${title} | ${SITE.legalName}` : `${SITE.legalName} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).href;
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={CSP} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={img('site/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={img('site/apple-touch-icon.png')} />
    <meta name="theme-color" content="#111214" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={SITE.legalName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    {ldJson && <script type="application/ld+json" set:html={ldJson} />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2">Saltar al contenido</a>
    <Header />
    <main id="main" class="flex-1"><slot /></main>
    <Footer />

    {floatingWa && <a
      href={waLink(`Hola ${SITE.name}, quisiera información sobre sus equipos.`)}
      target="_blank" rel="noopener noreferrer"
      class="fixed bottom-5 right-5 z-40 grid size-14 place-items-center rounded-full bg-wa text-white shadow-lg shadow-black/20 transition hover:scale-105"
      aria-label="Escríbanos por WhatsApp"
    ><Icon name="whatsapp" size={28} /></a>}

    <div id="toast" role="status" aria-live="polite"
      class="pointer-events-none fixed bottom-28 left-1/2 z-50 w-max max-w-[calc(100vw-2rem)] -translate-x-1/2 translate-y-4 rounded-2xl bg-ink px-5 py-3 text-center text-sm font-medium text-white opacity-0 shadow-xl ring-1 ring-white/10 transition duration-300"></div>

    <script>
      import { addToQuote, readQuote, onQuoteChange } from '../scripts/quote';

      const paint = () => {
        const n = readQuote().reduce((a, i) => a + i.qty, 0);
        document.querySelectorAll<HTMLElement>('[data-quote-count]').forEach((el) => {
          el.textContent = String(n);
          el.hidden = n === 0;
        });
        const slugs = new Set(readQuote().map((i) => i.slug));
        document.querySelectorAll<HTMLButtonElement>('[data-quote-add]').forEach((b) => {
          const added = slugs.has(b.dataset.slug ?? '');
          b.dataset.added = String(added);
          const label = b.querySelector<HTMLElement>('[data-label]');
          if (label) label.textContent = added ? (b.dataset.labelAdded ?? 'En la cotización') : (b.dataset.labelAdd ?? 'Agregar a cotización');
        });
      };

      let toastTimer = 0;
      const toast = (msg: string) => {
        const t = document.getElementById('toast');
        if (!t) return;
        t.textContent = msg;
        t.classList.remove('opacity-0', 'translate-y-4');
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => t.classList.add('opacity-0', 'translate-y-4'), 2200);
      };

      document.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-quote-add]');
        if (!b) return;
        e.preventDefault();
        const { slug = '', name = '', ref = '', image = '' } = b.dataset;
        addToQuote({ slug, name, ref, image: image || null });
        toast(`${name} agregado a su cotización`);
      });

      onQuoteChange(paint);
      paint();

      // Animación de aparición
      const io = new IntersectionObserver((entries) => {
        for (const en of entries) if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); }
      }, { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
